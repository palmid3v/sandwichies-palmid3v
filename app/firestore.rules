rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /orders/{orderId} {
      // Customer writes are performed by the Admin SDK inside createOrder.
      // Direct browser creation/deletion is never authorized.
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /counters/orders {
      // The trusted function owns this counter transaction.
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
