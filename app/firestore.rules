rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function orderStatus(data) {
      return data.get("status", "pendiente");
    }

    function paymentStatus(data) {
      return data.get("payment", {"status": "pendiente"}).get("status", "pendiente");
    }

    function validOrderStatusTransition() {
      let current = orderStatus(resource.data);
      let next = orderStatus(request.resource.data);
      let currentPayment = paymentStatus(resource.data);
      let nextPayment = paymentStatus(request.resource.data);

      return (
        current == next ||
        (current == "pendiente" && next == "confirmado") ||
        (current == "confirmado" && next == "preparando") ||
        (current == "preparando" && next == "listo") ||
        (current == "listo" && next == "entregado") ||
        (current == "pendiente" && next == "cancelado" && currentPayment == "pendiente" && nextPayment == "pendiente") ||
        (current == "confirmado" && next == "cancelado" && currentPayment == "pendiente" && nextPayment == "pendiente") ||
        (current == "preparando" && next == "cancelado" && currentPayment == "pendiente" && nextPayment == "pendiente") ||
        (current == "listo" && next == "cancelado" && currentPayment == "pendiente" && nextPayment == "pendiente")
      );
    }

    function validPaymentStatusTransition() {
      let currentOrder = orderStatus(resource.data);
      let current = paymentStatus(resource.data);
      let next = paymentStatus(request.resource.data);

      return ((current == next) || (
        current == "pendiente"
        && next == "pagado"
        && (
          currentOrder == "confirmado"
          || currentOrder == "preparando"
          || currentOrder == "listo"
          || currentOrder == "entregado"
        )
      ))
        && !(currentOrder == "cancelado" && current != next);
    }

    function validOrderUpdateFields() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let oldPayment = resource.data.get("payment", {});
      let newPayment = request.resource.data.get("payment", {});
      let paymentChangedKeys = newPayment.diff(oldPayment).affectedKeys();

      return changedKeys.hasOnly(["status", "payment", "updatedAt"])
        && paymentChangedKeys.hasOnly(["status"]);
    }

    match /orders/{orderId} {
      // Browser admins can change operational state only. Trusted order, financial,
      // customer, recipe and inventory snapshot fields remain immutable from clients.
      allow read: if isAdmin();
      // Browser clients may update payment metadata only. Order-state transitions
      // must pass through the trusted callable, which synchronizes Cupboard first.
      allow update: if isAdmin()
        && validOrderUpdateFields()
        && orderStatus(resource.data) == orderStatus(request.resource.data)
        && validPaymentStatusTransition();
      allow create, delete: if false;
    }

    match /counters/orders {
      allow read, write: if false;
    }

    match /inventoryBalances/{ingredientId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /inventoryTransactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
