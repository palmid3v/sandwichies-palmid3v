{
  "name": "sandwich-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "functions/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test",
    "security:test": "node test/security.rules.test.js",
    "emulators:test": "firebase emulators:exec --only firestore --project demo-sandwichies \"npm run security:test\"",
    "audit": "npm audit --omit=dev --audit-level=high",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm test && npm run security:test && npm run build",
    "provision:admin": "node scripts/provision-admin.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "html2canvas": "^1.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1",
    "@firebase/rules-unit-testing": "^5.1.0"
  }
}
